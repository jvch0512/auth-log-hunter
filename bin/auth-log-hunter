#!/usr/bin/env perl
use strict;
use warnings;
use FindBin qw($Bin);
use lib "$Bin/../lib";
use Getopt::Long qw(GetOptionsFromArray);
use AuthLogHunter;

my $usage = "auth-log-hunter <auth.log> [--year YYYY] [--window SECONDS] [--min-failures N] [--json | --html] [--fail-on-find]\n\nDetects SSH brute force, password spraying and success-after-failures. Offline.\nExit codes: 0 ok, 1 findings (with --fail-on-find), 2 bad input.\n";
my ($file, @args) = @ARGV;
if (!defined $file || $file =~ /^--/) { print STDERR $usage; exit 2 }
my %o = (year => 1900 + (gmtime)[5], window => 600, 'min-failures' => 10);
my ($json, $html, $fail);
GetOptionsFromArray(\@args, 'year=i' => \$o{year}, 'window=i' => \$o{window}, 'min-failures=i' => \$o{'min-failures'}, 'json' => \$json, 'html' => \$html, 'fail-on-find' => \$fail) or do { print STDERR $usage; exit 2 };
open(my $fh, '<', $file) or do { print STDERR "error: $file: $!\n"; exit 2 };
my $text = do { local $/; <$fh> };
close $fh;
my $ev = AuthLogHunter::parse($text, $o{year});
unless (@$ev) { print STDERR "error: no sshd events found (expected syslog-style lines)\n"; exit 2 }
my $fs = AuthLogHunter::analyze($ev, window => $o{window}, min_failures => $o{'min-failures'});
print $html ? AuthLogHunter::html($fs, scalar @$ev) : $json ? AuthLogHunter::json($fs) : AuthLogHunter::text($fs);
exit(($fail && @$fs) ? 1 : 0);
